    {
      "parameters": {
        "jsCode": "// دمج بيانات الرسالة مع الـ Session الحالي\nconst messageData = $('Extract Message Info').first().json;\nconst sessionRaw = $input.first().json?.value;\n\nlet session = {};\ntry {\n  session = sessionRaw ? JSON.parse(sessionRaw) : {};\n} catch(e) {\n  session = {};\n}\n\n// الحالة الافتراضية\nif (!session.state) {\n  session.state = 'idle';\n}\n\nreturn [{\n  json: {\n    ...messageData,\n    session\n  }\n}];"
      },
