    {
      "parameters": {
        "jsCode": "// استخراج معلومات الرسالة\nconst msg = $input.first().json;\nconst text = msg?.message?.text || '';\nconst chatId = msg?.message?.chat?.id;\nconst userId = msg?.message?.from?.id;\nconst username = msg?.message?.from?.first_name || 'عزيزي';\n\n// ✅ pattern موسع يشمل كل subdomains شي ان\nconst sheinPattern = /https?:\\/\\/([a-z0-9\\-]+\\.)*shein\\.(com|me|com\\.cn)[^\\s]*/gi;\nconst urls = text.match(sheinPattern) || [];\nconst hasSheinLink = urls.length > 0;\nconst sheinUrl = urls[0] || null;\n\n// تصنيف نوع الرسالة\nlet messageType = 'greeting';\nif (hasSheinLink) {\n  // ✅ روابط السلة المشتركة تيجي كـ sharejump مع cart في الـ link parameter\n  const urlLower = sheinUrl?.toLowerCase() || '';\n  if (\n    urlLower.includes('cart') ||\n    urlLower.includes('bag') ||\n    urlLower.includes('sharejump') // روابط المشاركة ممكن تكون سلة أو منتج، Claude يحدد\n  ) {\n    messageType = 'shared_link'; // نخلي Claude يقرر بعد ما يفتح الرابط\n  } else if (urlLower.includes('/product') || urlLower.includes('-p-')) {\n    messageType = 'product_link';\n  } else {\n    messageType = 'shared_link';\n  }\n}\n\nreturn [{\n  json: {\n    chatId,\n    userId: String(userId),\n    username,\n    text,\n    hasSheinLink,\n    sheinUrl,\n    messageType,\n    rawMessage: msg\n  }\n}];"
      },
      "id": "b3313632-e713-4cf4-a806-7aec5e50025b",
