      },
      "id": "cd5b1310-0f82-431f-a9d7-17014a175928",
      "name": "Ask Area",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        272,
        -384
      ]
    },
    {
      "parameters": {
        "jsCode": "// معالجة المنطقة وحساب التوصيل\nconst data = $input.first().json;\nconst areaInput = data.text?.trim().toLowerCase();\n\n// مناطق عمان\nconst ammanAreas = ['عمان', 'amman', 'العاصمة', 'الجاردنز', 'الشميساني', 'الرابية', 'صويلح', 'مرج الحمام', 'تلاع العلي', 'الجبيهة', 'ماركا', 'الزهور', 'وادي صقرة', 'الرشيد', 'الويبدة', 'جبل الحسين', 'جبل عمان', 'العبدلي', 'الدوار'];\n\nconst isAmman = ammanAreas.some(area => areaInput.includes(area.toLowerCase()));\nconst deliveryFee = isAmman ? 1 : 2;\nconst deliveryText = isAmman ? 'داخل عمان' : 'خارج عمان';\n\nconst productsTotal = data.session.productsTotal || 0;\nconst grandTotal = parseFloat((productsTotal + deliveryFee).toFixed(3));\n\nconst updatedSession = {\n  ...data.session,\n  state: 'waiting_confirmation',\n  customerArea: data.text?.trim(),\n  deliveryFee,\n  deliveryText,\n  grandTotal\n};\n\nreturn [{\n  json: {\n    ...data,\n    customerArea: data.text?.trim(),\n    deliveryFee,\n    deliveryText,\n    grandTotal,\n    productsTotal,\n    orderSummary: data.session.orderSummary,\n    customerName: data.session.customerName,\n    customerPhone: data.session.customerPhone,\n    sessionKey: 'session_' + data.userId,\n    sessionValue: JSON.stringify(updatedSession),\n    newSession: updatedSession\n  }\n}];"
      },
