        -880
      ]
    },
    {
      "parameters": {
        "jsCode": "// الرابط اللي وصلنا من Fetch Shein Page بعد الـ redirect\nconst response = $input.first();\n\n// n8n بيحفظ الـ URL النهائي بعد الـ redirect هون\nconst finalUrl = response.json.$response?.headers?.['x-final-url'] \n  || response.json.$response?.url\n  || $('Merge Session').first().json.sheinUrl;\n\n// استخرج اسم المنتج من الـ og:title أو title\nconst html = response.json.data || '';\nconst titleMatch = html.match(/<title[^>]*>([^<]+)<\\/title>/i);\nconst ogTitleMatch = html.match(/property=\"og:title\"\\s+content=\"([^\"]+)\"/i);\nconst ogPriceMatch = html.match(/property=\"product:price:amount\"\\s+content=\"([^\"]+)\"/i);\nconst ogImageMatch = html.match(/property=\"og:image\"\\s+content=\"([^\"]+)\"/i);\n\nconst productName = ogTitleMatch?.[1] || titleMatch?.[1] || 'منتج Shein';\nconst price = parseFloat(ogPriceMatch?.[1] || '0');\nconst imageUrl = ogImageMatch?.[1] || null;\n\nreturn [{\n  json: {\n    ...response.json,\n    extractedProduct: {\n      productName: productName.replace(' | SHEIN', '').trim(),\n      price,\n      imageUrl,\n      description: productName,\n      isCart: false,\n      cartItems: [],\n      cartTotal: 0\n    }\n  }\n}];"
      },
      "id": "2f83815c-c519-4cb6-906b-e203a2f55663",
      "name": "Parse Product Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        -880
      ]
    },
    {
      "parameters": {
        "jsCode": "// حفظ بيانات الطلب في الـ session\nconst data = $input.first().json;\n\nconst newSession = {\n  state: 'waiting_name',\n  sheinUrl: data.sheinUrl,\n  productData: data.productData,\n  orderSummary: data.orderSummary,\n  productsTotal: data.productsTotal\n};\n\nreturn [{\n  json: {\n    ...data,\n    newSession,\n    sessionKey: 'session_' + data.userId,\n    sessionValue: JSON.stringify(newSession)\n  }\n}];"
      },
