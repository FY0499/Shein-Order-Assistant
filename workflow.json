        -192
      ]
    },
    {
      "parameters": {
        "jsCode": "// معالجة التأكيد النهائي\nconst data = $input.first().json;\nconst response = data.text?.trim().toLowerCase();\nconst confirmed = ['نعم', 'yes', 'اكيد', 'أكيد', 'تمام', 'موافق', 'اوكي', 'ok', 'okay', '👍'].some(w => response.includes(w));\nconst cancelled = ['لا', 'no', 'الغاء', 'إلغاء', 'بطل', 'كنسل'].some(w => response.includes(w));\n\nreturn [{\n  json: {\n    ...data,\n    confirmed,\n    cancelled,\n    // نقل بيانات الـ session للاستخدام\n    customerName: data.session.customerName,\n    customerPhone: data.session.customerPhone,\n    customerArea: data.session.customerArea,\n    deliveryFee: data.session.deliveryFee,\n    deliveryText: data.session.deliveryText,\n    grandTotal: data.session.grandTotal,\n    productsTotal: data.session.productsTotal,\n    orderSummary: data.session.orderSummary,\n    sheinUrl: data.session.sheinUrl,\n    productData: data.session.productData,\n    orderDate: new Date().toLocaleString('ar-JO', {timeZone: 'Asia/Amman'}),\n    orderId: 'ORD-' + Date.now()\n  }\n}];"
      },
