    {
      "parameters": {
        "jsCode": "// معالجة الاسم وتحديث الـ session\nconst data = $input.first().json;\nconst name = data.text?.trim();\n\nconst updatedSession = {\n  ...data.session,\n  state: 'waiting_phone',\n  customerName: name\n};\n\nreturn [{\n  json: {\n    ...data,\n    customerName: name,\n    sessionKey: 'session_' + data.userId,\n    sessionValue: JSON.stringify(updatedSession),\n    newSession: updatedSession\n  }\n}];"
