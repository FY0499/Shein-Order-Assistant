    {
      "parameters": {
        "chatId": "={{ $('Process Area & Calculate Delivery').first().json.chatId }}",
        "text": "=تمام! إليك ملخص طلبك النهائي 🧾\n\n━━━━━━━━━━━━━━━\n{{ $('Process Area & Calculate Delivery').first().json.orderSummary }}\n\n🚚 *توصيل ({{ $('Process Area & Calculate Delivery').first().json.deliveryText }}):* {{ $('Process Area & Calculate Delivery').first().json.deliveryFee }} JOD\n\n✅ *الإجمالي الكلي: {{ $('Process Area & Calculate Delivery').first().json.grandTotal }} JOD*\n━━━━━━━━━━━━━━━\n\n👤 الاسم: {{ $('Process Area & Calculate Delivery').first().json.customerName }}\n📞 الهاتف: {{ $('Process Area & Calculate Delivery').first().json.customerPhone }}\n📍 المنطقة: {{ $('Process Area & Calculate Delivery').first().json.customerArea }}\n\nهل تأكد الطلب؟ اكتب *نعم* للتأكيد أو *لا* للإلغاء",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "Markdown"
        }
      },
      "id": "8bbfc110-c6a0-47ab-92d7-d36beb6f995b",
      "name": "Send Order Summary",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
